# Static assets cache (Cloudflare Pages concatenates Cache-Control on multi-match,
# so we avoid a catch-all /* and let unmatched paths fall through to Worker headers).
# Global security header still applied via catch-all without Cache-Control.

/screen_dashboard.png
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.avif
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

# Il giro completo: undici file da ~2,9 MB che non cambiano mai (se cambiano,
# cambia anche il nome). Senza questa riga il bordo li riscarica, e su mobile
# si paga due volte. I .jpg delle locandine li prende gia' la regola sopra.
/*.mp4
  Cache-Control: public, max-age=2592000, immutable

/*.vtt
  Cache-Control: public, max-age=2592000

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/*.ico
  Cache-Control: public, max-age=2592000

# Security header on all paths (no Cache-Control here → won't concatenate)
/*
  X-Content-Type-Options: nosniff

# Il verificatore offline e' un file unico che si scarica e si apre col doppio clic: deve restare
# BYTE PER BYTE quello di cui pubblichiamo il checksum. Servito come text/html, Cloudflare gli
# aggiunge in fondo lo script di rilevamento bot (/cdn-cgi/challenge-platform/scripts/jsd/main.js,
# +938 byte il 22/10/2026) e l'hash non torna. Come file da scaricare non viene riscritto.
# Dopo il deploy: curl -s URL | sha256sum deve dare lo stesso valore di geotapp-report-verifier/offline/SHA256SUMS (9f02ad23...2e12a).
/downloads/verificatore-geotapp.html
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="verificatore-geotapp.html"
  Cache-Control: public, no-transform, max-age=3600

# Il .html viene reindirizzato (307) al percorso senza estensione, ed e' QUELLO che serve il file:
# le intestazioni vanno messe anche li', altrimenti torna text/html e Cloudflare lo riscrive.
/downloads/verificatore-geotapp
  Content-Type: application/octet-stream
  Content-Disposition: attachment; filename="verificatore-geotapp.html"
  Cache-Control: public, no-transform, max-age=3600
